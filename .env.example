# Private operator host. Use an absolute path if the CLI is outside PATH.
DREAMINA_BIN=dreamina-canvas
# Obtain UUID from canvas ls and supported model IDs from model list.
DREAMINA_PROJECT_ID=
DREAMINA_IMAGE_MODEL=
DREAMINA_VIDEO_MODEL=
DREAMINA_RATIO=16:9
DREAMINA_IMAGE_RESOLUTION=1K
DREAMINA_VIDEO_RESOLUTION=720P
